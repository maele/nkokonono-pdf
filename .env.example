# Copy to .env and fill in for local development
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite:///instance/nkokonono.db
STORAGE_ROOT=storage

MAX_CONTENT_LENGTH=104857600
MAX_FILES_PER_JOB=20
MAX_PDF_PAGES=500
JOB_TIMEOUT_SECONDS=300
FILE_RETENTION_SECONDS=3600
LOG_LEVEL=INFO
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_JOB_CREATE=10 per minute
RATELIMIT_UPLOAD=30 per minute
MAX_CONCURRENT_JOBS_PER_IP=3
LOG_FORMAT=text
# Public project link shown in the navbar and About section
GITHUB_URL=https://github.com/maele/nkokonono-pdf

# Shown on the Contact page and footer
SUPPORT_EMAIL=support@nalaneindustries.co.za
